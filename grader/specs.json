{
  "vector-mean": {
    "function": "safe_mean",
    "public": [
      {
        "name": "ba số nguyên",
        "args": [
          [
            2,
            4,
            6
          ]
        ],
        "expected": 4.0
      },
      {
        "name": "số âm",
        "args": [
          [
            -2,
            1
          ]
        ],
        "expected": -0.5
      }
    ],
    "private": [
      {
        "name": "một phần tử",
        "args": [
          [
            8.25
          ]
        ],
        "expected": 8.25
      },
      {
        "name": "rỗng",
        "args": [
          []
        ],
        "raises": "ValueError"
      },
      {
        "name": "float",
        "args": [
          [
            0.1,
            0.2,
            0.3
          ]
        ],
        "expected": 0.2,
        "tolerance": 1e-09
      },
      {
        "name": "giá trị âm xen kẽ",
        "args": [
          [
            -5,
            5,
            -5,
            5
          ]
        ],
        "expected": 0.0,
        "tolerance": 1e-09
      },
      {
        "name": "một phần tử âm",
        "args": [
          [
            -3.5
          ]
        ],
        "expected": -3.5,
        "tolerance": 1e-09
      }
    ]
  },
  "linear-predict": {
    "function": "linear_predict",
    "public": [
      {
        "name": "một hàng",
        "args": [
          [
            [
              1,
              2
            ]
          ],
          [
            3,
            4
          ],
          1
        ],
        "expected": [
          12
        ]
      },
      {
        "name": "hai hàng",
        "args": [
          [
            [
              0,
              0
            ],
            [
              2,
              -1
            ]
          ],
          [
            2,
            3
          ],
          0.5
        ],
        "expected": [
          0.5,
          1.5
        ]
      }
    ],
    "private": [
      {
        "name": "bias âm",
        "args": [
          [
            [
              1
            ],
            [
              -2
            ]
          ],
          [
            2
          ],
          -1
        ],
        "expected": [
          1,
          -5
        ]
      },
      {
        "name": "sai chiều",
        "args": [
          [
            [
              1
            ]
          ],
          [
            1,
            2
          ],
          0
        ],
        "raises": "ValueError"
      },
      {
        "name": "ragged ở hàng sau",
        "args": [
          [
            [
              1,
              2
            ],
            [
              3
            ]
          ],
          [
            1,
            1
          ],
          0
        ],
        "raises": "ValueError"
      },
      {
        "name": "X rỗng trả list rỗng",
        "args": [
          [],
          [
            1,
            2
          ],
          0
        ],
        "expected": []
      },
      {
        "name": "nhiều hàng nhiều chiều",
        "args": [
          [
            [
              1,
              2,
              3
            ],
            [
              0,
              0,
              0
            ]
          ],
          [
            1,
            10,
            100
          ],
          2
        ],
        "expected": [
          323,
          2
        ]
      }
    ]
  },
  "knn-vote": {
    "function": "knn_vote",
    "public": [
      {
        "name": "đa số B",
        "args": [
          [
            [
              0.4,
              "A"
            ],
            [
              0.1,
              "B"
            ],
            [
              0.2,
              "B"
            ]
          ],
          3
        ],
        "expected": "B"
      },
      {
        "name": "chỉ k gần nhất",
        "args": [
          [
            [
              9,
              "B"
            ],
            [
              0.2,
              "A"
            ],
            [
              0.1,
              "A"
            ]
          ],
          2
        ],
        "expected": "A"
      }
    ],
    "private": [
      {
        "name": "hòa theo khoảng cách",
        "args": [
          [
            [
              0.1,
              "Z"
            ],
            [
              0.9,
              "A"
            ]
          ],
          2
        ],
        "expected": "Z"
      },
      {
        "name": "k không hợp lệ",
        "args": [
          [],
          1
        ],
        "raises": "ValueError"
      },
      {
        "name": "k = 0 không hợp lệ",
        "args": [
          [
            [
              0.1,
              "A"
            ]
          ],
          0
        ],
        "raises": "ValueError"
      },
      {
        "name": "k lớn hơn số láng giềng",
        "args": [
          [
            [
              0.1,
              "A"
            ]
          ],
          5
        ],
        "raises": "ValueError"
      },
      {
        "name": "hoà thì lấy nhãn theo thứ tự từ điển",
        "args": [
          [
            [
              0.5,
              "B"
            ],
            [
              0.5,
              "A"
            ]
          ],
          2
        ],
        "expected": "A"
      },
      {
        "name": "k bằng toàn bộ",
        "args": [
          [
            [
              0.3,
              "A"
            ],
            [
              0.1,
              "B"
            ],
            [
              0.2,
              "B"
            ]
          ],
          3
        ],
        "expected": "B"
      }
    ]
  },
